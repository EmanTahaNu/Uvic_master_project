#!/bin/bash

RESULTS_DIR="/Users/emantaha/Desktop/thesis/results"
BEDS_DIR="$RESULTS_DIR/beds"
OUT_DIR="$RESULTS_DIR/geodist_direction"

mkdir -p $OUT_DIR

MARKS=("H3K4me3" "H3K27ac" "H3K27me3" "H3K36me3" "H3K9me3")

for mark in "${MARKS[@]}"; do
  echo ""
  echo "=== $mark ==="

  for pos_bed in $BEDS_DIR/pos_${mark}_*.bed; do
    [ -f "$pos_bed" ] || continue

    # extract metabolite name
    base=$(basename $pos_bed)
    clean_met=${base#pos_${mark}_}
    clean_met=${clean_met%.bed}
    neg_bed=$BEDS_DIR/neg_${mark}_${clean_met}.bed

    echo "  $clean_met"

    # ── Positive × Positive ───────────────────────
    if [ $(wc -l < $pos_bed) -ge 2 ]; then
      sort -k1,1 -k2,2n $pos_bed > $RESULTS_DIR/tmp_a.bed

      echo -e "cCRE_1\tcCRE_2\tchr\tdistance_bp" > \
          $OUT_DIR/dist_pos_${mark}_${clean_met}.txt

      bedtools closest \
          -a $RESULTS_DIR/tmp_a.bed \
          -b $RESULTS_DIR/tmp_a.bed \
          -d -io | \
      awk 'BEGIN{OFS="\t"} $NF >= 0 && $8 != "." {
          print $4, $8, $1, $NF
      }' >> $OUT_DIR/dist_pos_${mark}_${clean_met}.txt

       [ $(wc -l < $OUT_DIR/dist_pos_${mark}_${clean_met}.txt) -le 1 ] && \
          rm $OUT_DIR/dist_pos_${mark}_${clean_met}.txt && \
          echo "    Pos: no same-chr pairs — file removed" || \
          echo "    Pos pairs: $(tail -n +2 $OUT_DIR/dist_pos_${mark}_${clean_met}.txt | wc -l)"
    fi

    # ── Negative × Negative ───────────────────────
    if [ -f "$neg_bed" ] && [ $(wc -l < $neg_bed) -ge 2 ]; then
      sort -k1,1 -k2,2n $neg_bed > $RESULTS_DIR/tmp_b.bed

      echo -e "cCRE_1\tcCRE_2\tchr\tdistance_bp" > \
          $OUT_DIR/dist_neg_${mark}_${clean_met}.txt

      bedtools closest \
          -a $RESULTS_DIR/tmp_b.bed \
          -b $RESULTS_DIR/tmp_b.bed \
          -d -io | \
      awk 'BEGIN{OFS="\t"} $NF >= 0 && $8 != "." {
          print $4, $8, $1, $NF
      }' >> $OUT_DIR/dist_neg_${mark}_${clean_met}.txt

      [ $(wc -l < $OUT_DIR/dist_neg_${mark}_${clean_met}.txt) -le 1 ] && \
          rm $OUT_DIR/dist_neg_${mark}_${clean_met}.txt && \
          echo "    Neg: no same-chr pairs — file removed" || \
          echo "    Neg pairs: $(tail -n +2 $OUT_DIR/dist_neg_${mark}_${clean_met}.txt | wc -l)"
    fi

  done
done

rm -f $RESULTS_DIR/tmp_a.bed $RESULTS_DIR/tmp_b.bed

echo ""
echo "=== Summary ==="
echo "Positive distance files: $(ls $OUT_DIR/dist_pos_*.txt 2>/dev/null | wc -l)"
echo "Negative distance files: $(ls $OUT_DIR/dist_neg_*.txt 2>/dev/null | wc -l)"
echo "Done"
